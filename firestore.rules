rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shortLinks/{shortCode} {
      // Anyone can read a short link
      allow read: if true;
      
      // Anyone can create a short link
      allow create: if true;
      
      // Only the owner can update or delete their links
      allow update, delete: if request.auth != null && 
                             resource.data.userId == request.auth.uid;
                             
      // Allow updating click count for any link
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'lastClickedAt']);
    }
  }
}