
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read short links
    match /shortLinks/{shortCode} {
      allow read: if true;
      // Allow updates only to clicks and lastClickedAt fields
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'lastClickedAt']);
      // Allow create/delete for authenticated users
      allow create, delete: if request.auth != null;
    }
  }
}
